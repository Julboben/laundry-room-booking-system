{
    "name": "association/laundry-booking",
    "description": "Browser-based laundry-room booking system for a residential association",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "LaundryBooking\\": "app/"
        },
        "files": [
            "app/Support/Security.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaundryBooking\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
