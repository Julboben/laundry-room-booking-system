{
    admin off
    auto_https off
}

:{$PORT} {
    root * /app/public
    encode zstd br gzip

    # CSS and JS URLs carry a ?v=<mtime> version, so they can be cached indefinitely.
    @versionedAssets path /assets/*.css /assets/*.js
    header @versionedAssets Cache-Control "public, max-age=31536000, immutable"

    php_server
}
